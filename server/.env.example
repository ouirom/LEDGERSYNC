PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:@localhost:3306/ledgersync"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_generate_a_random_64_char_hex_string
JWT_REFRESH_SECRET=changeme_generate_a_different_random_64_char_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Tolerance (micro-écart en devise)
MICRO_ECART_SEUIL=0.05

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Email (SMTP) — laisser vide en développement : les emails sont alors
# simplement journalisés dans la console au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LedgerSync <no-reply@ledgersync.demo>"
