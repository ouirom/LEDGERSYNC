PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:@localhost:3306/ledgersync"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_SECRET=ledgersync_jwt_super_secret_key_change_in_production
JWT_REFRESH_SECRET=ledgersync_refresh_super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Tolerance (micro-écart en devise)
MICRO_ECART_SEUIL=0.05

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
